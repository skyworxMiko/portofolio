<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jamiko Arshal | Portofolio</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&display=swap"
        rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --primary: #1d4ed8;
            --primary-light: #eff6ff;
            --dark: #0b0f19;
            /* Footer background */
            --darker: #050810;
            --gold: #dcb348;
            /* Quote background */
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-500: #64748b;
            --gray-800: #1e293b;
            --success: #10b981;

            --font-heading: 'Playfair Display', serif;
            --font-body: 'Inter', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 100px;
        }

        body {
            font-family: var(--font-body);
            color: var(--gray-800);
            background-color: #ffffff;
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* --- Navigation --- */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            border-bottom: 1px solid transparent;
            padding: 1.5rem 0;
            background: transparent;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        nav.scrolled {
            padding: 1rem 0;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
        }

        .nav-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--dark);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--gray-500);
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
        }

        .nav-links a {
            position: relative;
            text-decoration: none;
            color: var(--gray-500);
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s ease;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--primary);
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-links a:hover {
            color: var(--dark);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.95rem;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            gap: 0.5rem;
        }

        .btn-dark {
            background-color: var(--dark);
            color: #fff;
            border: 1px solid var(--dark);
        }

        .btn-dark:hover {
            background-color: #000;
        }

        .btn-outline {
            background-color: #fff;
            color: var(--gray-800);
            border: 1px solid var(--gray-200);
        }

        .btn-outline:hover {
            border-color: var(--gray-500);
        }

        .btn-primary {
            background-color: var(--primary);
            color: #fff;
            border: 1px solid var(--primary);
        }

        .btn-primary:hover {
            background-color: #1e40af;
        }

        /* --- Hero Section --- */
        .hero {
            padding: 5rem 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .availability-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background-color: var(--primary-light);
            color: var(--primary);
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2rem;
        }

        .dot-group {
            display: flex;
            gap: 4px;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .dot-green {
            background-color: var(--success);
        }

        .dot-blue {
            background-color: var(--primary);
        }

        .hero-title {
            font-family: var(--font-heading);
            font-size: 4.5rem;
            line-height: 1.1;
            color: var(--dark);
            margin-bottom: 1.5rem;
            letter-spacing: -1px;
        }

        .hero-title i {
            color: var(--primary);
            font-style: italic;
        }

        .hero-desc {
            font-size: 1.1rem;
            color: var(--gray-500);
            margin-bottom: 2.5rem;
            line-height: 1.8;
            max-width: 90%;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
        }

        /* --- Identity Card --- */
        .id-card {
            background-color: var(--gray-50);
            border: 1px solid var(--gray-200);
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .id-avatar {
            width: 60px;
            height: 60px;
            background-color: var(--primary);
            color: #fff;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        .id-name {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            color: var(--dark);
            margin-bottom: 0.2rem;
        }

        .id-role {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2rem;
            display: block;
        }

        .id-list {
            display: flex;
            flex-direction: column;
        }

        .id-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid var(--gray-200);
            font-size: 0.95rem;
        }

        .id-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .id-label {
            color: var(--gray-500);
        }

        .id-value {
            font-weight: 600;
            color: var(--dark);
        }

        .id-value.highlight {
            color: var(--primary);
            background: var(--primary-light);
            padding: 0.2rem 0.8rem;
            border-radius: 50px;
            font-size: 0.85rem;
        }

        .id-value.success {
            color: var(--success);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        /* --- Stats Block --- */
        .stats-block {
            background-color: var(--darker);
            border-radius: 20px;
            padding: 4rem;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-top: 2rem;
            margin-bottom: 5rem;
        }

        .stat-item {
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-item:last-child {
            border-right: none;
        }

        .stat-num {
            font-family: var(--font-heading);
            font-size: 3.5rem;
            color: #fff;
            line-height: 1;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
        }

        .stat-num span {
            color: var(--primary);
            font-size: 2rem;
            font-family: var(--font-body);
            font-weight: 300;
            margin-left: 2px;
        }

        .stat-label {
            color: var(--gray-500);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            line-height: 1.5;
            padding-right: 2rem;
        }

        /* --- Section Shared --- */
        .section-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 3rem;
            margin-top: 4rem;
        }

        .section-header::before {
            content: '';
            width: 40px;
            height: 2px;
            background-color: var(--primary);
        }

        .section-header h2 {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--gray-500);
        }

        /* --- Skills Grid --- */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 6rem;
        }

        .skill-card {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: 12px;
            padding: 2rem 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .skill-card.active {
            border-color: var(--primary);
            background-color: var(--primary-light);
        }

        .skill-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }

        .skill-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .skill-title {
            font-weight: 700;
            color: var(--dark);
            font-size: 0.95rem;
            margin-bottom: 0.3rem;
        }

        .skill-desc {
            font-size: 0.8rem;
            color: var(--gray-500);
        }

        /* --- Timeline & Deployments --- */
        .timeline {
            border-left: 2px solid var(--gray-200);
            padding-left: 2rem;
            margin-left: 1rem;
        }

        .time-item {
            position: relative;
            margin-bottom: 3rem;
        }

        .time-item:last-child {
            margin-bottom: 0;
        }

        .time-dot {
            position: absolute;
            left: -2.6rem;
            top: 5px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid var(--primary);
        }

        .time-role {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            color: var(--dark);
            margin-bottom: 0.2rem;
        }

        .time-meta {
            font-size: 0.85rem;
            color: var(--gray-500);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
        }

        .time-desc {
            color: var(--gray-500);
            font-size: 0.95rem;
            line-height: 1.7;
            max-width: 700px;
        }

        .deploy-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .dep-card {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: 12px;
            padding: 2rem;
            transition: all 0.3s;
        }

        .dep-card:hover {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border-color: var(--primary);
        }

        .dep-client {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
        }

        .dep-title {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            margin-bottom: 0.8rem;
            color: var(--dark);
        }

        .dep-desc {
            font-size: 0.9rem;
            color: var(--gray-500);
            line-height: 1.6;
        }

        /* --- Innovation Spotlight --- */
        .spotlight-card {
            background: var(--gray-50);
            border: 1px solid var(--gray-200);
            border-radius: 20px;
            padding: 3rem;
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 2rem;
            margin-bottom: 1rem;
        }

        .spot-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1.5rem;
        }

        .spot-title {
            font-family: var(--font-heading);
            font-size: 2.5rem;
            color: var(--dark);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .spot-desc {
            font-size: 1.1rem;
            color: var(--gray-500);
            line-height: 1.8;
        }

        .stack-box {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: 12px;
            padding: 2rem;
        }

        .stack-title {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--gray-500);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1.5rem;
        }

        .stack-list {
            list-style: none;
        }

        .stack-list li {
            position: relative;
            padding-left: 1.5rem;
            margin-bottom: 1rem;
            font-weight: 500;
            color: var(--dark);
            font-size: 0.95rem;
        }

        .stack-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 8px;
            width: 6px;
            height: 6px;
            background-color: var(--primary);
            border-radius: 50%;
        }

        /* --- Architect Quote Section --- */
        .quote-section {
            background-color: var(--primary);
            padding: 8rem 0;
            position: relative;
            overflow: hidden;
            margin-top: 4rem;
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: var(--font-body);
            font-size: clamp(8rem, 20vw, 18rem);
            font-weight: 800;
            color: rgba(255, 255, 255, 0.15);
            pointer-events: none;
            white-space: nowrap;
            z-index: 1;
            letter-spacing: -2px;
        }

        .quote-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
            margin: 0 auto;
            text-align: left;
        }

        .quote-text {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 4vw, 3.5rem);
            color: #1a1a1a;
            line-height: 1.3;
            margin-bottom: 2rem;
            font-style: italic;
            font-weight: 600;
            letter-spacing: -0.5px;
        }

        .quote-text strong {
            font-style: normal;
            font-weight: 800;
        }

        .quote-author {
            font-family: var(--font-body);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 1rem;
            color: #1a1a1a;
            text-align: right;
            margin-bottom: 3rem;
            padding-right: 2rem;
        }

        .quote-action {
            text-align: right;
        }

        .btn-gold-dark {
            background-color: #0b0f19;
            color: var(--gold);
            padding: 1.2rem 2.5rem;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            transition: all 0.3s;
        }

        .btn-gold-dark:hover {
            background-color: #000;
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        /* --- Footer Reference Match --- */
        footer {
            background-color: var(--dark);
            padding: 6rem 0 2rem;
            color: #94a3b8;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-bottom: 6rem;
        }

        .footer-logo {
            font-family: var(--font-body);
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 2px;
            margin-bottom: 1rem;
            text-transform: uppercase;
        }

        .footer-logo span {
            color: var(--gold);
        }

        .footer-bio {
            font-size: 0.95rem;
            line-height: 1.8;
            max-width: 350px;
            margin-bottom: 3rem;
        }

        .footer-heading {
            font-family: var(--font-body);
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #475569;
            margin-bottom: 2rem;
        }

        /* Nav List in Footer */
        .footer-nav-list {
            list-style: none;
        }

        .footer-nav-list li {
            margin-bottom: 1.2rem;
        }

        .footer-nav-list a {
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        .footer-nav-list a:hover {
            color: #ffffff;
        }

        /* Contact List in Footer */
        .footer-contact-list {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .contact-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.95rem;
        }

        .contact-row i {
            color: #475569;
        }

        .contact-row span {
            color: #cbd5e1;
        }

        /* Footer Bottom Bar */
        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: #64748b;
        }

        /* --- Animations --- */
        .fade-in {
            opacity: 0;
            transform: translateY(30px) scale(0.98);
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        @media(max-width: 900px) {
            .hero {
                grid-template-columns: 1fr;
                padding: 3rem 0;
            }

            .stats-block {
                grid-template-columns: 1fr 1fr;
                gap: 2rem;
                padding: 2rem;
            }

            .stat-item {
                border-right: none;
            }

            .spotlight-card {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .footer-top {
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            .nav-links {
                display: none;
            }

            .quote-text {
                font-size: 2rem;
            }

            .quote-author,
            .quote-action {
                text-align: left;
            }

            .watermark {
                font-size: 8rem;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <nav>
        <div class="container nav-inner">
            <a href="#" class="logo">Jamiko <span>Arshal</span></a>
            <div class="nav-links">
                <a href="#proyek">PROYEK</a>
                <a href="#pengalaman">PENGALAMAN</a>
                <a href="#keahlian">KEAHLIAN</a>
                <a href="#kontak">KONTAK</a>
            </div>
            <a href="#kontak" class="btn btn-dark">Hubungi Saya</a>
        </div>
    </nav>

    <main class="container">

        <!-- Hero Section -->
        <section class="hero fade-in">
            <div class="hero-content">
                <div class="availability-badge">
                    <div class="dot-group">
                        <div class="dot dot-green"></div>
                        <div class="dot dot-blue"></div>
                    </div>
                    TERSEDIA UNTUK PELUANG BARU
                </div>

                <h1 class="hero-title">
                    Enterprise Solutions Architect <br>& <i>Tech Lead</i>
                </h1>

                <p class="hero-desc">
                    Arsitek sistem enterprise berskala nasional dengan rekam jejak di perbankan, fintech, layanan
                    publik, dan kesehatan. Spesialis otomatisasi backend-to-frontend untuk keputusan lebih cepat dan
                    operasional lebih efisien.
                </p>

                <div class="hero-actions">
                    <a href="#proyek" class="btn btn-dark">
                        Lihat Portofolio <i data-lucide="arrow-down" style="width: 16px;"></i>
                    </a>
                    <a href="#kontak" class="btn btn-outline">
                        <i data-lucide="mail" style="width: 16px; color: var(--primary);"></i> Hubungi Saya
                    </a>
                </div>
            </div>

            <!-- Identity Card -->
            <div class="id-card fade-in" style="transition-delay: 0.2s;">
                <div class="id-avatar">JA</div>
                <h2 class="id-name">Jamiko Arshal</h2>
                <span class="id-role">SOLUTIONS ARCHITECT & TECH LEAD</span>

                <div class="id-list">
                    <div class="id-item">
                        <span class="id-label">Perusahaan</span>
                        <span class="id-value highlight">PT. Skyworx Indonesia</span>
                    </div>
                    <div class="id-item">
                        <span class="id-label">Lokasi</span>
                        <span class="id-value">Padang, Indonesia</span>
                    </div>
                    <div class="id-item">
                        <span class="id-label">Email</span>
                        <span class="id-value" style="color: var(--primary);">arshaljamiko@gmail.com</span>
                    </div>
                    <div class="id-item">
                        <span class="id-label">Telp</span>
                        <span class="id-value">0822-8748-3950</span>
                    </div>
                    <div class="id-item">
                        <span class="id-label">Pendidikan</span>
                        <span class="id-value">S1 Sistem Informasi</span>
                    </div>
                    <div class="id-item">
                        <span class="id-label">Status</span>
                        <span class="id-value success">
                            <div class="dot dot-green"></div> Aktif Bekerja
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Block -->
        <div class="stats-block fade-in" id="pengalaman">
            <div class="stat-item">
                <div class="stat-num">7<span>+</span></div>
